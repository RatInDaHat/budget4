    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
